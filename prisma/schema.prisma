generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String    @id @default(cuid())
  name                    String
  email                   String    @unique
  password                String
  mfaEnabled              Boolean   @default(false)
  mfaSecret               String?
  aiMemoryEnabled         Boolean   @default(true)
  notificationsEnabled    Boolean   @default(true)
  pushNotificationsEnabled Boolean  @default(true)
  createdAt               DateTime  @default(now())
  profiles                Profile[]
  wishlistItems           WishlistItem[]
}

model Profile {
  id                String             @id @default(cuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  avatar            String             @default("😊")
  color             String             @default("#155EEF")
  type              String             @default("personal") // "budget" | "personal" | "business" | "savings"
  monthlyBudget     Float              @default(15000)
  savingsGoal       Float              @default(2000)
  streakResetAt     String?            // YYYY-MM-DD; only count streak dates >= this
  createdAt         DateTime           @default(now())
  expenses          Expense[]
  conversations     Conversation[]
  categoryBudgets   CategoryBudget[]
  monthlyBudgets    MonthlyBudget[]
  recurringExpenses RecurringExpense[]
  achievements      Achievement[]
  notifications     Notification[]
}

model Expense {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  date      String
  category  String
  item      String
  amount    Float
  fixed     Boolean? // explicit fixed-bill flag; null = infer from category/item
  createdAt DateTime @default(now())

  @@index([profileId, date])
  @@index([profileId, category, date])
}

model Conversation {
  id        String    @id @default(cuid())
  profileId String
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title     String
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([profileId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String       // "user" or "ai"
  content        String       @db.Text
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model MonthlyBudget {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  year        Int
  month       Int      // 1-12
  budget      Float
  savingsGoal Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([profileId, year, month])
}

model CategoryBudget {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  category  String
  limit     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, category])
}

model RecurringExpense {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  category    String
  item        String
  amount      Float
  frequency   String   // "monthly", "weekly", "biweekly"
  dayOfMonth  Int?     // for monthly: 1-31
  dayOfWeek   Int?     // for weekly: 0-6 (Sunday-Saturday)
  fixed       Boolean  @default(false) // big committed bill — exclude from spending analytics
  lastRunDate String?  // YYYY-MM-DD
  nextRunDate String   // YYYY-MM-DD
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([profileId, active])
  @@index([active, nextRunDate])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  price     Float
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Achievement {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type        String
  title       String
  description String
  icon        String?
  unlockedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([profileId, unlockedAt])
}

model Notification {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String   @db.Text
  read      Boolean  @default(false)
  actionUrl String?
  createdAt DateTime @default(now())

  @@index([profileId, createdAt])
  @@index([profileId, read])
}
